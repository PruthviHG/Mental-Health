{
  "name": "mindsence",
  "version": "2.0.0",
  "private": true,
  "description": "Multilingual AI mental-wellness companion",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint:syntax": "find js -name \"*.js\" -exec node --check {} \\;",
    "build:css": "tailwindcss -c tools/tailwind.config.js -i assets/src/tailwind.input.css -o assets/css/tailwind.css --minify",
    "build:icons": "python tools/build_icons.py node_modules/@fortawesome/fontawesome-free/svgs/solid",
    "bench": "python tools/benchmark_browser.py && node tools/benchmark.js",
    "e2e": "python tests/e2e_smoke.py"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "tailwindcss": "^3.4.17",
    "@fortawesome/fontawesome-free": "^6.0.0"
  }
}
